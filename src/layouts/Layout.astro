---
import '@fontsource-variable/inter'
import '@fontsource-variable/jetbrains-mono'
import '@fontsource-variable/bricolage-grotesque'
import '../styles/global.css'
import ThemeToggle from '../components/ThemeToggle.astro'
import CambiarIdioma from '../components/CambiarIdioma.astro'
import { getTextos } from '../i18n/textos'

const idioma = Astro.currentLocale === 'en' ? 'en' : 'es'
const t = getTextos(idioma).meta
const nav = getTextos(idioma).nav
---

<!doctype html>
<html lang={idioma} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <title>{t.titulo}</title>
    <meta property="og:title" content={t.titulo} />
    <meta property="og:description" content={t.descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.locale} />
    <script is:inline>
      const guardado = localStorage.getItem('theme')
      if (guardado) document.documentElement.dataset.theme = guardado
    </script>
  </head>
  <body>
    <header class="barra">
      <div class="fila container">
        <a class="marca mono" href={nav.inicio} aria-label={nav.volverArriba}>VGM</a>
        <nav class="secciones">
          {nav.secciones.map((s) => <a href={s.h}>{s.t}</a>)}
        </nav>
        <div class="controles">
          <CambiarIdioma />
          <ThemeToggle />
        </div>
      </div>
    </header>
    <slot />

    <script>
      const barra = document.querySelector('.barra')
      let anterior = window.scrollY

      window.addEventListener(
        'scroll',
        () => {
          const actual = window.scrollY
          const bajando = actual > anterior
          barra?.classList.toggle('oculta', bajando && actual > 140)
          anterior = actual
        },
        { passive: true },
      )
    </script>
  </body>
</html>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  /* Se esconde al bajar y vuelve al subir. La clase la pone el script. */
  .barra.oculta {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .barra {
      transition: transform 0.3s ease;
    }
  }
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    min-height: 3.4rem;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .marca:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .secciones {
    display: flex;
    gap: 1.7rem;
    font-size: 0.92rem;
  }
  .secciones a {
    display: inline-flex;
    align-items: center;
    min-height: 3.4rem;
    color: var(--muted);
    font-weight: 500;
  }
  .secciones a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .controles {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* En mobile no entra la marca, así que dejamos solo links y controles. */
  @media (max-width: 760px) {
    .fila {
      width: 100%;
      padding-inline: 0.45rem;
      gap: 0.2rem;
    }
    .marca {
      display: none;
    }
    .secciones {
      flex: 1;
      justify-content: space-between;
      gap: 0;
      font-size: 0.68rem;
    }
    .secciones a {
      min-height: 3.1rem;
      padding-inline: 0.1rem;
      white-space: nowrap;
    }
  }
</style>
