---
import { getTextos } from '../i18n/textos'

const t = getTextos(Astro.currentLocale).nav
---

<button id="theme-toggle" type="button" role="switch" aria-label={t.cambiarTema}>
  <span class="track">
    <span class="knob"></span>
    <span class="ico sol">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <circle cx="12" cy="12" r="4.5"></circle>
        <path d="M12 1.5v2m0 17v2M4 4l1.4 1.4m13.2 13.2L20 20M1.5 12h2m17 0h2M4 20l1.4-1.4M18.6 5.4 20 4"></path>
      </svg>
    </span>
    <span class="ico luna">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
    </span>
  </span>
</button>

<script>
  const btn = document.getElementById('theme-toggle')
  const sincronizar = () => {
    btn?.setAttribute('aria-checked', String(document.documentElement.dataset.theme === 'dark'))
  }
  sincronizar()
  btn?.addEventListener('click', () => {
    const nuevo = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = nuevo
    localStorage.setItem('theme', nuevo)
    sincronizar()
  })
</script>

<style>
  button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.6rem;
    margin-right: -0.6rem;
    border: 0;
    background: none;
    cursor: pointer;
    line-height: 0;
  }

  .track {
    display: block;
    position: relative;
    width: 3.4rem;
    height: 1.9rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color 0.2s ease;
  }
  button:hover .track {
    border-color: var(--accent);
  }

  .knob {
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: -0.7rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .ico {
    position: absolute;
    top: 50%;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: -0.7rem;
    display: grid;
    place-items: center;
    color: var(--muted);
  }
  .ico svg {
    width: 0.85rem;
    height: 0.85rem;
  }
  .sol {
    left: 0.2rem;
    color: var(--bg);
  }
  .luna {
    right: 0.2rem;
  }

  :root[data-theme='dark'] .knob {
    transform: translateX(1.4rem);
  }
  :root[data-theme='dark'] .sol {
    color: var(--muted);
  }
  :root[data-theme='dark'] .luna {
    color: var(--bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .knob,
    .ico {
      transition:
        transform 0.25s ease,
        color 0.25s ease;
    }
  }

  @media (max-width: 760px) {
    button {
      padding-inline: 0.3rem;
      margin-right: 0;
    }
    .track {
      transform: scale(0.85);
    }
  }
</style>
