---
import { getTextos } from '../i18n/textos'

const t = getTextos(Astro.currentLocale).experiencia
---

<section class="exp" id="experiencia">
  <div class="container">
    <h2 class="label">{t.titulo}</h2>
    <div class="cols">
    <div class="col">
      <h3 class="colh mono">{t.colEmpleos}</h3>
      <div class="tl">
        {
          t.empleos.map((r) => (
            <div class="item">
              <div class="head">
                <h4>
                  {r.puesto} · <span class="accent">{r.empresa}</span>
                </h4>
                <span class="mono fecha">{r.lugar} · {r.fechas}</span>
              </div>
              <ul>
                {r.puntos.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="col">
      <h3 class="colh mono">
        <span>{t.colFreelance}</span>
        <span class="fecha">{t.fechasFreelance}</span>
      </h3>
      <div class="tl">
        {
          t.proyectos.map((p) => (
            <div class="item">
              <h4>
                {p.n}
                {p.ancla ? (
                  <a href={`#${p.ancla}`} class="doc mono">
                    {t.verAbajo}
                  </a>
                ) : (
                  <span class="doc mono priv">{t.codigoCliente}</span>
                )}
              </h4>
              <p class="d">{p.d}</p>
            </div>
          ))
        }
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  .exp {
    background: var(--surface);
    padding-block: var(--section-pad);
  }
  .label {
    margin-bottom: 1.8rem;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  .colh {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.2rem 1rem;
    color: var(--text);
    font-weight: 500;
    margin-bottom: 1.4rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
  }
  .tl {
    border-left: 2px solid var(--line);
    padding-left: 1.5rem;
    display: grid;
    gap: 1.6rem;
  }
  .item {
    position: relative;
  }
  .item::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 6px);
    top: 0.4rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--surface);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.4rem 1rem;
    flex-wrap: wrap;
  }
  h4 {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .accent {
    color: var(--accent);
  }
  .fecha {
    color: var(--muted);
    white-space: nowrap;
    font-size: 0.8rem;
  }
  .item ul {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .item li {
    margin-bottom: 0.2rem;
  }
  .d {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .doc {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.8rem 0.3rem;
    margin-block: -0.8rem;
    font-size: 0.72rem;
    color: var(--accent);
    font-weight: 400;
  }
  .priv {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
  }
</style>
