---
import ProjectFeature from './ProjectFeature.astro'
import About from './About.astro'
import Experiencia from './Experiencia.astro'
import Skills from './Skills.astro'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import foto from '../assets/valentino.jpg'
import { getTextos } from '../i18n/textos'

const t = getTextos(Astro.currentLocale)
const enIngles = Astro.currentLocale === 'en'

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden)
---

<main>
  <section class="hero container">
    <div class="texto">
      <p class="mono kicker">{t.hero.kicker}</p>
      <h1>{t.hero.tituloA}<span class="accent">{t.hero.tituloB}</span>.</h1>
      <p class="intro">{t.hero.intro}</p>
    </div>
    <Image
      class="foto"
      src={foto}
      alt={t.hero.altFoto}
      width={400}
      height={400}
      densities={[1, 2]}
      loading="eager"
    />
  </section>

  <About />
  <Experiencia />

  <section class="proyectos container" id="proyectos">
    <h2 class="label">{t.proyectos.titulo}</h2>
    <div class="features">
      {
        proyectos.map((p, i) => (
          <ProjectFeature
            {...p.data}
            descripcion={enIngles && p.data.descripcionEn ? p.data.descripcionEn : p.data.descripcion}
            id={p.id}
            reverse={i % 2 === 1}
          />
        ))
      }
    </div>
  </section>

  <Skills />

  <section class="cierre container" id="contacto">
    <h2>{t.cierre.titulo}</h2>
    <p class="bajada">{t.cierre.texto}</p>
    <div class="canales">
      {
        t.cierre.canales.map((c) => (
          <a
            class="canal"
            href={c.u}
            target={c.u.startsWith('mailto:') ? undefined : '_blank'}
            rel={c.u.startsWith('mailto:') ? undefined : 'noopener'}
          >
            <Icon name={c.i} />
            <span class="nombre">{c.n}</span>
            <span class="detalle">{c.d}</span>
          </a>
        ))
      }
    </div>
  </section>
</main>

<footer class="container">
  <p class="mono">valentino garcía méndez · paraná, argentina · {new Date().getFullYear()}</p>
</footer>

<style>
  .hero {
    padding-block: 3rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3.5rem;
    align-items: center;
  }
  .foto {
    width: 400px;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .kicker {
    margin-bottom: 1.6rem;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    max-width: 16ch;
  }
  .accent {
    color: var(--accent);
  }
  .intro {
    color: var(--muted);
    font-size: 1.15rem;
    margin-top: 1.6rem;
    max-width: 44ch;
  }
  .proyectos {
    padding-block: var(--section-pad);
  }
  .label {
    margin-bottom: 1.8rem;
  }
  .features {
    display: grid;
    gap: 4rem;
  }

  .cierre {
    padding-block: var(--section-pad);
  }
  .bajada {
    color: var(--muted);
    max-width: 48ch;
    margin-top: 0.9rem;
  }
  .canales {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
    margin-top: 2.2rem;
  }
  .canal {
    display: grid;
    gap: 0.55rem;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
  }
  .canal:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .canal svg {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--accent);
  }
  .nombre {
    font-weight: 600;
    font-size: 0.98rem;
  }
  .detalle {
    color: var(--muted);
    font-size: 0.88rem;
  }

  footer {
    padding-block: 3rem 4rem;
    margin-top: 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8rem;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.2rem;
      padding-block: 1.5rem 3rem;
    }
    .foto {
      width: 100%;
      max-width: 400px;
    }
  }
</style>
