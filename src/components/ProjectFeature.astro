---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { getTextos } from '../i18n/textos'

const t = getTextos(Astro.currentLocale).proyectos

interface Props {
  id?: string
  titulo: string
  descripcion: string
  stack: string[]
  imagen?: ImageMetadata
  demo?: string
  repo?: string
  reverse?: boolean
}

const { id, titulo, descripcion, stack, imagen, demo, repo, reverse = false } = Astro.props
---

<article class:list={['feature', { reverse }]} id={id}>
  <div class="media">
    {
      imagen ? (
        <Image
          src={imagen}
          alt={t.altImagen.replace('{titulo}', titulo)}
          widths={[640, 1080, 1600]}
          sizes="(max-width: 760px) 100vw, 640px"
          quality={85}
          loading="lazy"
        />
      ) : (
        <span class="ph">{titulo}</span>
      )
    }
  </div>
  <div class="body">
    <h3>{titulo}</h3>
    <p class="desc">{descripcion}</p>
    <ul class="stack">
      {stack.map((t) => <li>{t}</li>)}
    </ul>
    {
      (demo || repo) && (
        <div class="links">
          {demo && (
            <a class="primary" href={demo} target="_blank" rel="noopener">
              {t.verDemo}
            </a>
          )}
          {repo && (
            <a
              class="repo"
              href={repo}
              target="_blank"
              rel="noopener"
              title={t.tituloCodigo}
              aria-label={t.verCodigo.replace('{titulo}', titulo)}
            >
              <Icon name="simple-icons:github" />
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: start;
  }
  .body {
    padding-top: 0.4rem;
  }
  .feature.reverse .media {
    order: 2;
  }

  .feature.reverse {
    grid-template-columns: 0.85fr 1.15fr;
  }
  .media {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    background: var(--surface);
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .media img {
      transition: transform 0.35s ease;
    }
    .media:hover img {
      transform: scale(1.04);
    }
  }
  .ph {
    font-weight: 800;
    color: var(--accent);
    opacity: 0.5;
    font-size: 1.6rem;
  }

  h3 {
    font-size: 1.7rem;
    margin-bottom: 0.6rem;
  }
  .desc {
    color: var(--muted);
    font-size: 1rem;
    margin-bottom: 1.4rem;
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 0 0 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .stack li {
    font-family: var(--mono);
    font-size: 0.72rem;
    background: var(--surface);
    color: var(--muted);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }
  .links {
    display: flex;
    gap: 0.8rem;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .links a {
    padding: 0.5em 1.1em;
    border-radius: 8px;
    border: 1px solid var(--line);
    color: var(--text);
  }
  .links a:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
  .links .primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .links .primary:hover {
    opacity: 0.9;
    color: var(--bg);
  }
  .links .repo {
    display: inline-flex;
    align-items: center;
    padding-inline: 0.75em;
  }
  .links .repo svg {
    width: 1.25em;
    height: 1.25em;
    display: block;
  }
  .stack:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .feature,
    .feature.reverse {
      grid-template-columns: 1fr;
      gap: 1.3rem;
    }
    .feature.reverse .media {
      order: 0;
    }
    h3 {
      font-size: 1.4rem;
    }
  }
</style>
