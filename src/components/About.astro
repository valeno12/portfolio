---
import { getTextos } from '../i18n/textos'

const t = getTextos(Astro.currentLocale).about
const negrita = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
---

<section class="about container" id="sobre-mi">
  <h2 class="label">{t.titulo}</h2>
  <div class="inner">
    <div class="texto">
      <p set:html={negrita(t.p1)} />
      <p set:html={negrita(t.p2)} />
      <p>{t.p3}</p>
    </div>
    <ul class="datos mono">
      {t.datos.map((d) => <li>{d}</li>)}
    </ul>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-pad);
  }
  .label {
    margin-bottom: 1.6rem;
  }
  .inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .texto p {
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .texto :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .datos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.82rem;
  }
  .datos li {
    padding-left: 1rem;
    position: relative;
  }
  .datos li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  @media (max-width: 620px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
